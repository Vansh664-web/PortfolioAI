# PostgreSQL application connection. Use a NOSUPERUSER/NOBYPASSRLS role that does not own tables.
DATABASE_URL="postgresql://portfolioai_app:change-me@localhost:5432/portfolioai?schema=public"

# Google AI Studio (Gemini). When GEMINI_API_KEY is set it takes precedence over xAI.
# Server-side only; never expose this key to the browser.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
# Comma-separated models tried when the primary model is retired or overloaded.
GEMINI_MODEL_FALLBACKS="gemini-3.1-flash-lite"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

# Optional xAI fallback (used only when GEMINI_API_KEY is empty).
# Obtain from the xAI developer console. These values are used server-side only.
XAI_API_KEY=""
XAI_MODEL=""
XAI_BASE_URL="https://api.x.ai/v1"
# Optional request timeout in milliseconds (5,000–120,000), applies to either provider.
# Gemini thinking models often need more than 30 seconds.
XAI_TIMEOUT_MS="60000"

# Generate and configure locally; do not commit a real secret.
AUTH_SECRET=""

# Public portfolio URL base; set this to your production domain at deployment
NEXT_PUBLIC_PORTFOLIO_BASE_URL="http://localhost:3000"

# Transactional email provider. This application currently supports Resend.
# Local development auto-verifies new accounts and does not send email.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""

# Shared production rate limiting (Upstash Redis REST). Required when NODE_ENV=production.
# Development uses a process-local limiter and is not suitable for multiple instances.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
